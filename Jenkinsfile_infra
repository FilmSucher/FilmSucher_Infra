pipeline {
    agent any

    stages {
	
		stage('Checkout') {
            steps {
                checkout scm
            }
        }

		stage('Copy Kafka to Ansible container') {
            steps {
                sh '''
					rm -rf /shared/infra_kafka/server.properties
					cp -r kafka/server.properties /shared/infra_kafka/server.properties
                '''
            }
        }
		
		stage('Deploy Kafka via Ansible') {
            steps {
                sh '''
                    docker exec ansible \
                      ansible-playbook -i inventory.ini playbooks/deploy-kafka.yml -v
                '''
            }
        }
		
		stage('Copy Logstash to Ansible container') {
            steps {
                sh '''
					rm -rf /shared/infra_logstash/logstash.conf
					cp -r logstash/logstash.conf /shared/infra_logstash/logstash.conf
                '''
            }
        }
		
		stage('Deploy Logstash via Ansible') {
            steps {
                sh '''
                    docker exec ansible \
                      ansible-playbook -i inventory.ini playbooks/deploy-logstash.yml -v
                '''
            }
        }
		
		stage('Copy Kibana to Ansible container') {
            steps {
                sh '''
					rm -rf /shared/infra_kibana/kibana.yml
					cp -r kibana/kibana.yml /shared/infra_kibana/kibana.yml
                '''
            }
        }
		
		stage('Deploy Kibana via Ansible') {
            steps {
                sh '''
                    docker exec ansible \
                      ansible-playbook -i inventory.ini playbooks/deploy-kibana.yml -v
                '''
            }
        }
		
		stage('Copy FileBeat to Ansible container') {
            steps {
                sh '''
					rm -rf /shared/infra_filebeat/filebeat_vm-front.yml
					cp -r filebeat/filebeat_vm-front.yml /shared/infra_filebeat/filebeat_vm-front.yml
					
					rm -rf /shared/infra_filebeat/filebeat_vm-db.yml
					cp -r filebeat/filebeat_vm-db.yml /shared/infra_filebeat/filebeat_vm-db.yml
					
					rm -rf /shared/infra_filebeat/filebeat_vm-infra.yml
					cp -r filebeat/filebeat_vm-infra.yml /shared/infra_filebeat/filebeat_vm-infra.yml
                '''
            }
        }
		
		stage('Deploy FileBeat via Ansible') {
            steps {
                sh '''
                    docker exec ansible \
                      ansible-playbook -i inventory.ini playbooks/deploy-filebeat.yml -v
                '''
            }
        }
		
		stage('Copy Prometheus to Ansible container') {
            steps {
                sh '''
					rm -rf /shared/infra_prometheus/prometheus.yml
					cp -r prometheus/prometheus.yml /shared/infra_prometheus/prometheus.yml
                '''
            }
        }
		
		stage('Deploy Prometheus via Ansible') {
            steps {
                sh '''
                    docker exec ansible \
                      ansible-playbook -i inventory.ini playbooks/deploy-prometheus.yml -v
                '''
            }
        }
		
		stage('Copy Grafana to Ansible container') {
            steps {
                sh '''
					rm -rf /shared/infra_grafana/grafana.ini
					cp -r grafana/grafana.ini /shared/infra_grafana/grafana.ini
					
					rm -rf /shared/infra_grafana/prometheus.yml
					cp -r grafana/prometheus.yml /shared/infra_grafana/prometheus.yml
                '''
            }
        }
		
		stage('Deploy Grafana via Ansible') {
            steps {
                sh '''
                    docker exec ansible \
                      ansible-playbook -i inventory.ini playbooks/deploy-grafana.yml -v
                '''
            }
        }
    }
	
	post {
        failure {
            echo 'Deploy failed.'
        }
        success {
            echo 'Infra deployed successfully.'
        }
    }
}
